{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game component extraction 1.0",
  "description": "Game-agnostic record of the physical components found in a game's source documents: what is printed on each item, nothing more. No rules modelling, no interpretation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "game",
    "sources",
    "component_kinds",
    "items"
  ],
  "properties": {
    "spec_version": {
      "const": "extraction-1.0"
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Authors, publisher, illustrators, as printed."
        }
      }
    },
    "sources": {
      "description": "Every input document, or set of item image files.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "content"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "A document, or a file pattern such as cards/*.png for one image per item."
          },
          "pages": {
            "type": "integer",
            "minimum": 1,
            "description": "For documents."
          },
          "content": {
            "type": "string",
            "description": "What the document contains, e.g. 'rulebook page', 'card sheet: fronts on page 1, backs on page 2'."
          },
          "layout": {
            "type": "string",
            "description": "For component sheets: grid size, orientation, how backs map to fronts."
          }
        }
      }
    },
    "component_kinds": {
      "description": "One entry per kind of component (a card type, a token type, a board). Declares the fields its items carry.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "fields",
          "count_found"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "fields": {
            "description": "Every field the items of this kind carry in `fields`, with type and what is printed.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "description"
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/id"
                },
                "type": {
                  "enum": [
                    "integer",
                    "string",
                    "enum",
                    "list"
                  ]
                },
                "enum_values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": {
                  "type": "string",
                  "description": "Where on the item this is printed and how it was read, e.g. 'number of filled gold circles along the right edge'."
                }
              }
            }
          },
          "count_found": {
            "type": "integer",
            "minimum": 0,
            "description": "Physical items of this kind in the files."
          },
          "count_in_rules": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Count the rules text gives for this kind, copied as printed; null if none."
          },
          "back": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the back of this kind looks like."
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "description": "One entry per physical item the game uses: each item the component files show (copies listed separately), and each item the rules name that no file shows, whose source is then the rules document page that gives its number.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "fields",
          "from_rules",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "<file stem>#p<page>_r<row>_c<col> for grid sheets, row/col 0-based from the top-left of the front page as rendered; <file stem>#p<page>_<kind>_<nn> for items only the rules name."
          },
          "kind": {
            "type": "string",
            "description": "component_kinds id"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "page"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              },
              "row": {
                "type": "integer"
              },
              "col": {
                "type": "integer"
              },
              "back_page": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "back_row": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "back_col": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Printed name, spelled exactly as printed."
          },
          "fields": {
            "type": "object",
            "description": "Values for the kind's declared fields. Only declared names."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Other printed text, verbatim, lines joined with ' / '. Leave out illegible decorative fine print."
          },
          "back": {
            "type": [
              "string",
              "null"
            ],
            "description": "Only if this item's back differs from its kind's back."
          },
          "from_rules": {
            "type": "boolean",
            "description": "true when the item is not shown in any file and was added from a count in the rules (source is then the rules page); false when it was read from a file."
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "extraction_notes": {
      "description": "How the extraction was done and what is uncertain: method, illegible items, anything you could not read.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$"
    }
  }
}
